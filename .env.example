# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws / deploy (backend -> ecr -> ecs fargate + alb + rds) ---
# Read by scripts/deploy-backend.sh, passed on to infra/backend.yaml.
# Of the three services only RDS has a free tier: the ALB and the Fargate task
# bill from the first hour, so `make destroy-backend` when you are done.
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
# Credentials for pushing to ECR and driving CloudFormation. Leave the keys
# blank to fall back to AWS_PROFILE, SSO, or an instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# --- stack ---
PROJECT_NAME=peach
STACK_NAME=peach-backend

# --- network (blank -> the region's default VPC and its default subnets) ---
AWS_VPC_ID=
AWS_PUBLIC_SUBNET_IDS=
# Private subnets need a NAT gateway, which costs more than everything else
# in this stack put together. Left empty, tasks run in the public subnets.
AWS_PRIVATE_SUBNET_IDS=

# --- image ---
ECR_REPOSITORY=peach-backend
# Blank -> the current git sha.
IMAGE_TAG=
# arm64 (Graviton) is cheaper on Fargate and builds natively on Apple Silicon.
TASK_ARCHITECTURE=arm64

# --- fargate (256/512 is the smallest, and cheapest, task Fargate sells) ---
ECS_CONTAINER_PORT=8000
ECS_TASK_CPU=256
ECS_TASK_MEMORY=512
# Keep this at 1: the container runs migrations on boot, and a second task
# would race it for the alembic lock.
ECS_DESIRED_COUNT=1
# Blank -> ENABLED in public subnets, DISABLED once private ones are set.
ECS_ASSIGN_PUBLIC_IP=

# --- rds (free tier: 750h/month of db.t4g.micro + 20 GB, 12 months) ---
DB_NAME=peach
DB_USERNAME=peach
DB_INSTANCE_CLASS=db.t4g.micro
DB_ALLOCATED_STORAGE=20
DB_ENGINE_VERSION=17
# The password is generated on the first deploy and lives in Secrets Manager;
# the task reads the whole connection string from there by ARN.

# --- backend runtime on aws ---
# APP_ENV above stays "development" for Compose; this is what ECS gets.
APP_ENV_AWS=production
# The deployed frontend's origin - narrow this once you have one.
API_CORS_ORIGINS=*
# --- github actions (make github-role) ---
# Blank -> read from the origin remote.
GITHUB_REPO=
# Which workflow runs may assume the deploy role. "*" would let any branch and
# any pull request deploy, so main only by default.
GITHUB_SUBJECT_CLAIM=ref:refs/heads/main

# --- frontend (s3 + cloudfront) ---
# Blank -> the backend stack's ApiUrl. This is compiled into the bundle, so it
# must be the deployed API, not the localhost one above.
FRONTEND_API_URL=
# PriceClass_100 is North America + Europe, and the cheapest.
CLOUDFRONT_PRICE_CLASS=PriceClass_100

# --- custom domain (set by `make domain DOMAIN=api.example.com`) ---
DOMAIN_NAME=
# Route 53 zone for DOMAIN_NAME; set, the stack owns the alias record.
HOSTED_ZONE_ID=
# An ACM certificate in this region adds an HTTPS listener on 443 and makes
# plain HTTP redirect to it. `make cert` fills this in.
ACM_CERTIFICATE_ARN=
